# Copy to .env for `docker compose up` (or export these before `npm start`).
# Never commit the real values. See "Authentication" in README.md.

# Pocket ID (or any OpenID Connect provider)
OIDC_ISSUER_URL=https://id.roses.casa
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Public URL of this app. The OIDC callback URL is ${BASE_URL}/callback.
BASE_URL=https://das-ist-gut.roses.casa

# Encrypts the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
